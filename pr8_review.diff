+    # concurrent Percept uploads decode in parallel rather than queueing. Workers capped at 4
+    # ($$(( $$(nproc) < 4 ? $$(nproc) : 4 )) — $$ escapes $ so bash, not compose, expands it).
+    # nproc=16 on the lab Mac caused RAM exhaustion after a few --reload cycles; 4 workers cover
+    # all realistic concurrent dev load and stay well under 2 GiB. --timeout 600 tolerates the
+    # slow synchronous JSON decode of large sessions.
     command: >
       bash -c "env >> /etc/environment && service nginx start && python3 manage.py migrate &&

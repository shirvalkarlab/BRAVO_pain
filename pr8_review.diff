+                ? `${bc.contact_label || bc.contact || "band"} @ ${fmt(bc.center_freq_hz, 1)} Hz · `
+                  + `${data.n_gates_passed}/${data.n_gates} gates`
+                  + (data.n_gates_indeterminate ? ` · ${data.n_gates_indeterminate} not tested` : "")
+                  + ` · ${data.verdict}`

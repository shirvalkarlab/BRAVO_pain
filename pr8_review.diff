+            {!data ? "hourglass_empty" : ready ? "check_circle" : "report_problem"}
+          </Icon>
+          <MDBox>
+            <MDTypography variant="h6" sx={{ fontSize: 16, lineHeight: 1.15, color: textColor }}>
+              {loading ? "Assembling deployment verdict…"

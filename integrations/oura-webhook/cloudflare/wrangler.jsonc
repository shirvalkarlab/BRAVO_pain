{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bravo-oura-notifications",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"ACTIVATION_APPROVED": "false"},
  "durable_objects": {
    "bindings": [{"name": "NOTIFICATIONS", "class_name": "NotificationStore"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["NotificationStore"]}]
}

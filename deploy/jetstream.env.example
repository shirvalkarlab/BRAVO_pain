# Copy to the Git-ignored .env.jetstream; keep that file mode 0600.
# Empty required fields deliberately prevent accidental startup.
BUILD_REVISION=
BRAVO_DOMAIN=
BRAVO_DB_DIRECTORY=
BRAVO_DATA_DIRECTORY=
BRAVO_PRIVATE_DIRECTORY=
MYSQL_ROOT_PASSWORD=
BRAVO_DATABASE_PASSWORD=
DJANGO_SECRET_KEY=
DATASERVER_HASHKEY=
DATASERVER_ENCRYPTION=
BRAVO_WEB_WORKERS=4
BRAVO_POOL_JOBS=4
# Start with loopback. Verify DNS/interface/isolation before public exposure.
# For initial public TLS, deliberately bind the intended interface and permit
# TCP 80/443 to Caddy; start it, then verify its certificate and normal login.
BRAVO_BIND_ADDRESS=127.0.0.1
BRAVO_PROXY_SUBNET=172.29.240.0/28
BRAVO_PROXY_IP=172.29.240.3
# Optional vendor connections; keep empty unless deliberately configured.
REDCAP_API_URL=
REDCAP_API_TOKEN=
# Private participant field maps go in <BRAVO_PRIVATE_DIRECTORY>/participant-config.
# Set this only after verifying the account/participant binding in the private JSON.
BRAVO_OURA_MANAGED_CONFIG_FILE=
# FIBIT is the retained upstream environment-variable spelling.
FIBIT_CLIENT_ID=
FIBIT_CLIENT_SECRET=
GoogleHealth_CLIENT_ID=
GoogleHealth_CLIENT_SECRET=
GoogleHealth_CLIENT_REDIRECT_URI=

# Optional admin-triggered sync mailbox (private configuration; separate host workers).
BRAVO_MANUAL_SYNC_CONFIG_FILE=

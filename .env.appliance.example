# Generate the real ignored file with: scripts/bravo-appliance init
BRAVO_HTTP_PORT=8080
BRAVO_WEB_WORKERS=4
MYSQL_DATABASE=BRAVOServer
MYSQL_USER=BRAVOAdmin
MYSQL_ROOT_PASSWORD=replace-with-a-generated-secret
MYSQL_PASSWORD=replace-with-a-generated-secret
DATASERVER_ENCRYPTION=replace-with-a-generated-fernet-key
DATASERVER_HASHKEY=replace-with-a-generated-secret
DJANGO_SECRET_KEY=replace-with-a-generated-secret

# Optional reviewed Percept canonical data folder for REDCap program/medication views.
# Contains stim/ and medications/ subfolders; mounted read-only by sync only.
RCS08_COMPARISON_SOURCE=./secrets/rcs08_comparisons

# Existing local destination for atomic REDCap/Oura CSV exports after each sync.
# Only this folder is mounted read/write. Set the authorized Dropbox folder here.
RCS08_EXPORT_SOURCE=./output/rcs08-exports

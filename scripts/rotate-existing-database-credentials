#!/usr/bin/env bash

set -euo pipefail

container="${1:-}"
env_file="${2:-}"
[[ -n "$container" && -f "$env_file" ]] || {
  printf 'Usage: rotate-existing-database-credentials <mysql-container> <appliance-env>\n' >&2
  exit 1
}

env_value() {
  local key="$1"
  sed -n "s/^${key}=//p" "$env_file" | tail -n 1
}

database_user="$(env_value MYSQL_USER)"
database_password="$(env_value MYSQL_PASSWORD)"
root_password="$(env_value MYSQL_ROOT_PASSWORD)"

[[ "$database_user" =~ ^[A-Za-z0-9_]+$ ]] || { printf 'Unsafe MYSQL_USER\n' >&2; exit 1; }
[[ "$database_password" =~ ^[A-Za-z0-9_-]+$ ]] || { printf 'Unsafe generated MYSQL_PASSWORD\n' >&2; exit 1; }
[[ "$root_password" =~ ^[A-Za-z0-9_-]+$ ]] || { printf 'Unsafe generated MYSQL_ROOT_PASSWORD\n' >&2; exit 1; }

{
  printf "ALTER USER '%s'@'%%' IDENTIFIED BY '%s';\n" "$database_user" "$database_password"
  printf "ALTER USER 'root'@'%%' IDENTIFIED BY '%s';\n" "$root_password"
  printf "ALTER USER 'root'@'localhost' IDENTIFIED BY '%s';\n" "$root_password"
} | docker exec -i "$container" sh -c 'exec mysql -uroot -p"$MYSQL_ROOT_PASSWORD"'

printf 'Rotated existing BRAVO MySQL credentials without changing database contents.\n'
